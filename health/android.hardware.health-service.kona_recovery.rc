service vendor.health-default /system/bin/hw/android.hardware.health-service.kona_recovery
    class hal
    seclabel u:r:hal_health_default:s0
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w

service charger /system/bin/hw/android.hardware.health-service.kona_recovery --charger
    override
    class charger
    critical
    seclabel u:r:charger:s0
    user root
    group system wakelock input
    capabilities SYS_BOOT
    file /dev/kmsg w
