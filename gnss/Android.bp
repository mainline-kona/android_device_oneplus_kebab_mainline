cc_binary {
    name: "kona-gnss",
    vendor: true,
    defaults: [
        "libqmi_glib_dep_defaults",
        "libqmi_libqmi_glib_dep_defaults",
    ],
    srcs: ["gnss.c"],
    cflags: [
        "-DHAVE_CONFIG_H",
        "-Wno-deprecated-declarations",
        "-Wno-unused-parameter",
    ],
    header_libs: [
        "libqmi_config_header",
        "libqmi_top_headers",
    ],
    shared_libs: [
        "libgio-2.0",
        "libgobject-2.0",
        "libqrtr-glib",
    ],
}

cc_binary {
    name: "android.hardware.gnss-service.kona",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["hal/android.hardware.gnss-service.kona.rc"],
    vintf_fragments: ["hal/android.hardware.gnss-service.kona.xml"],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    defaults: [
        "gnss_use_latest_hal_aidl_ndk_shared",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libbinder_ndk",
        "libhidlbase",
        "libutils",
        "liblog",
        "android.hardware.gnss@2.1",
        "android.hardware.gnss@2.0",
        "android.hardware.gnss@1.0",
        "android.hardware.gnss.measurement_corrections@1.1",
        "android.hardware.gnss.measurement_corrections@1.0",
        "android.hardware.gnss.visibility_control@1.0",
    ],
    srcs: ["hal/*.cpp"],
    static_libs: [
        "android.hardware.gnss@common-default-lib",
    ],
}
