import /vendor/etc/init/hw/init.mainline.qcom.rc

on early-init
    # The RPMB listener tells UFS from eMMC by where this points;
    # qcom-common's bootdevice/by-name then resolves to the controller's own by-name
    symlink /dev/block/platform/soc@0/1d84000.ufshc /dev/block/bootdevice
    # Bring-up: keep logs on /metadata, which survives any reset and is readable from recovery
    mkdir /metadata/bringup 0777 root root

on init
    # init.rc zeroes hung_task_timeout_secs; re-enable so boot stalls log stack traces
    write /proc/sys/kernel/hung_task_timeout_secs 30
    # qseecomd bridge for stock KeyMint & Gatekeeper
    symlink /dev/qseecom_bridge /dev/qseecom
    # UFS RPMB well-known LU and query node for RPMB listener
    chown system system /dev/0:0:0:49476
    chmod 0660 /dev/0:0:0:49476
    chown system system /dev/ufs-bsg0
    chmod 0660 /dev/ufs-bsg0
    symlink /dev/dma_heap/system /dev/dma_heap/qcom,qseecom
    symlink /dev/dma_heap/system /dev/dma_heap/qseecom
    symlink /dev/dma_heap/system /dev/dma_heap/qseecom_ta
    # QTI Gralloc DMA-BUF heaps -> mainline system / system-uncached heaps
    symlink /dev/dma_heap/system /dev/dma_heap/qcom,system
    symlink /dev/dma_heap/system-uncached /dev/dma_heap/qcom,system-uncached
    symlink /dev/dma_heap/system /dev/dma_heap/qcom,display

on fs
    mount_all --early

on late-fs
    mount_all --late

on boot
    # Allow AIDL Health HAL (LONG_LIFE 80% cap) and LineageOS Charging Control
    # (both running as system:system) to toggle MP2650 bypass charging.
    chown system system /sys/class/power_supply/mp2650-charger/charge_behaviour
    chmod 0664 /sys/class/power_supply/mp2650-charger/charge_behaviour
    chown system system /sys/class/power_supply/mp2650-charger/charging_enabled
    chmod 0664 /sys/class/power_supply/mp2650-charger/charging_enabled

    # Allow AIDL Type-C USB HAL (running as system:system) to switch roles
    chown system system /sys/class/typec/port0/data_role
    chmod 0664 /sys/class/typec/port0/data_role
    chown system system /sys/class/typec/port0/power_role
    chmod 0664 /sys/class/typec/port0/power_role
    chown system system /sys/class/typec/port0/port_type
    chmod 0664 /sys/class/typec/port0/port_type
    chown system system /sys/class/typec/port0/preferred_role
    chmod 0664 /sys/class/typec/port0/preferred_role

    # UVC USB Webcam gadget function (DeviceAsWebcam + UsbGadget HAL uvc.0)
    mkdir /config/usb_gadget/g1/functions/uvc.0
    write /config/usb_gadget/g1/functions/uvc.0/function_name "OnePlus 8T Webcam"
    write /config/usb_gadget/g1/functions/uvc.0/streaming_maxpacket 3072
    write /config/usb_gadget/g1/functions/uvc.0/streaming_maxburst 13
    mkdir /config/usb_gadget/g1/functions/uvc.0/control/header/h
    symlink /config/usb_gadget/g1/functions/uvc.0/control/header/h /config/usb_gadget/g1/functions/uvc.0/control/class/fs/h
    symlink /config/usb_gadget/g1/functions/uvc.0/control/header/h /config/usb_gadget/g1/functions/uvc.0/control/class/ss/h
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/wWidth 640
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/wHeight 480
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/dwDefaultFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/dwFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/dwMinBitRate 18432000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/dwMaxBitRate 55296000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/480p/dwMaxVideoFrameBufferSize 614400
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/wWidth 1280
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/wHeight 720
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/dwDefaultFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/dwFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/dwMinBitRate 55296000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/dwMaxBitRate 165888000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/720p/dwMaxVideoFrameBufferSize 1843200
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/wWidth 1920
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/wHeight 1080
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/dwDefaultFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/dwFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/dwMinBitRate 124416000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/dwMaxBitRate 373248000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m/1080p/dwMaxVideoFrameBufferSize 4147200
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/wWidth 640
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/wHeight 480
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/dwDefaultFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/dwFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/dwMinBitRate 147456000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/dwMaxBitRate 147456000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/480p/dwMaxVideoFrameBufferSize 614400
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/wWidth 1280
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/wHeight 720
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/dwDefaultFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/dwFrameInterval 333333
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/dwMinBitRate 442368000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/dwMaxBitRate 442368000
    write /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u/720p/dwMaxVideoFrameBufferSize 1843200
    mkdir /config/usb_gadget/g1/functions/uvc.0/streaming/header/h
    symlink /config/usb_gadget/g1/functions/uvc.0/streaming/mjpeg/m /config/usb_gadget/g1/functions/uvc.0/streaming/header/h/m
    symlink /config/usb_gadget/g1/functions/uvc.0/streaming/uncompressed/u /config/usb_gadget/g1/functions/uvc.0/streaming/header/h/u
    symlink /config/usb_gadget/g1/functions/uvc.0/streaming/header/h /config/usb_gadget/g1/functions/uvc.0/streaming/class/fs/h
    symlink /config/usb_gadget/g1/functions/uvc.0/streaming/header/h /config/usb_gadget/g1/functions/uvc.0/streaming/class/hs/h
    symlink /config/usb_gadget/g1/functions/uvc.0/streaming/header/h /config/usb_gadget/g1/functions/uvc.0/streaming/class/ss/h
    chown system system /config/usb_gadget/g1/functions/uvc.0

on post-fs-data
    # GP secure storage directory for qseecomd's libdrmfs listener
    mkdir /data/vendor/tzstorage 0770 system system
    # Camera persistent cache / tuning / EEPROM directory
    mkdir /data/vendor/camera 0770 cameraserver camera
    # The X55 probes TFTP at ~11 s, before qcom-common's "boot" action runs.
    # Create /data/vendor/tmp/tqftpserv here (after installkey /data has set up
    # FBE in post-fs-data) so tqftpserv can serve /readwrite/ on first boot.
    mkdir /data/vendor/tmp 0755 root root
    mkdir /data/vendor/tmp/tqftpserv 0755 root root
    restorecon_recursive /data/vendor/tmp

on post-fs
    mkdir /mnt/vendor/persist/klog 0775 root system
    # SLPI sensor registry, served by hexagonrpcd-sdsp via hexagonrpcd-root/sensors/registry
    mkdir /mnt/vendor/persist/sensors 0775 system system
    mkdir /mnt/vendor/persist/sensors/registry 0775 system system
    mkdir /mnt/vendor/persist/sensors/registry/registry 0775 system system
    # DSP/Venus firmware is the stock split .mdt/.bNN set on the modem partition
    # (mounted at /vendor/firmware_mnt by mount_all). The DT asks for "adsp.mdt",
    # "cdsp.mdt", "slpi.mdt" and "venus.mdt", so point the kernel loader there
    # before (re)starting the remoteprocs.
    write /sys/module/firmware_class/parameters/path /vendor/firmware_mnt/image
    # Configure local QRTR node ID before early QRTR services (tqftpserv, pd-mapper)
    # and DSP remoteprocs start.
    exec - root -- /vendor/bin/qrtr-cfg 1
    # The X55 fetches its MCFG/RF config files over TFTP (QRTR service 4096)
    # while it boots, a few seconds after sbl1.mbn becomes readable here.
    # qcom-common only starts tqftpserv at "boot", well after the modem asked
    # (it then came up with no RF: zero bands, stuck offline), so serve them
    # from now on. Debug build of the service: every request goes to kmsg.
    start vendor.tqftpserv_early
    # Venus loads firmware at probe time (before /vendor was mounted); retry now
    write /sys/bus/platform/drivers/qcom-venus/bind aa00000.video-codec
    # pd-mapper and hexagonrpcd must be running before SLPI/ADSP boot in
    # kebab-pdready.sh so SLPI sensors are ready before class_start hal starts
    # vendor.sensors-mainline (avoiding 60s of libssc QMI discovery timeouts).
    start vendor.pd-mapper
    start vendor.hexagonrpcd-sdsp
    start vendor.hexagonrpcd-adsp-rootpd
    # EFS write-back: disabled during bringup to protect mdm1m9kefs* flash partitions
    # from persistent corruption until modem boot stability is fully proven.
    write /sys/module/sahara_mdm/parameters/efs_writeback 0
    # Voice audio calibration level 0 (topology bypass to prevent ADSP -5 failures)
    write /sys/module/q6voice/parameters/cal_level 0
    start vendor.kebab_pdready
    # Load Titan 480 camera kernel module (includes synx) once /vendor/firmware
    # is mounted, wait for ueventd to create all V4L2 subdev nodes, then start
    # the HIDL 2.4 camera provider with libcamhidl_shim.
    insmod /vendor/lib/modules/camera.ko
    wait /dev/v4l-subdev25 5
    start vendor.camera-provider-2-4
    # The external SDX55 is flashless: mhi-pci-generic stays bound and powers
    # it up by itself once sdx55m/sbl1.mbn is readable through the path above
    # (do NOT unbind/rebind it here: that aborts the SBL transfer mid-flight).
    # Bring-up loggers (vendor.bringup_{kmsg,logcat,diag}) are left disabled by
    # default so continuous /metadata/bringup writes don't keep UFS active 95%
    # of the time; start manually via ctl.start if needed for debugging.

# SM8250 has no internal modem (kebab uses an external SDX55), so rmtfs has no
# remote to serve and restart-loops forever; stop it instead of respawning.
on property:init.svc.vendor.rmtfs=restarting
    stop vendor.rmtfs

# Early TFTP server for the external modem (see post-fs). Only one server may
# own QRTR service 4096, so keep qcom-common's late instance from starting.
# "-i 3": stock tftp_server publishes one instance per remote and the X55's
# MPSS only looks up instance 3 (/vendor/rfs/mdm/mpss); instance 1 alone is
# never found, so the modem never fetched its MCFG / RF card files.
service vendor.tqftpserv_early /vendor/bin/tqftpserv -i 3
    class core
    user root
    group system
    disabled

service vendor.kebab_pdready /vendor/bin/kebab-pdready.sh
    user root
    group root
    oneshot
    disabled

# DSPs start only after pd-mapper has published the protection-domain maps.
# hexagonrpcd waits in-process for /dev/fastrpc-* so it attaches within 50ms of DSP boot.
on property:sys.kebab.pdready=1
    trigger start_all_remoteproc

on property:init.svc.vendor.tqftpserv=running
    stop vendor.tqftpserv

service vendor.bringup_kmsg /vendor/bin/bringup-log.sh kmsg
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

service vendor.bringup_diag /vendor/bin/bringup-log.sh diag
    user root
    group root radio
    seclabel u:r:su:s0
    oneshot
    disabled

service vendor.bringup_logcat /vendor/bin/bringup-log.sh logcat
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

# zram swap: 50% of RAM, lz4 (zram is built into the kernel)
on property:sys.boot_completed=1
    # Prevent brief RT task wakeups (e.g. irq/dwc3, sugov) from slamming CPUs
    # (especially prime cpu7) to max 2.84 GHz while idle; top-app/ADPF uclamp
    # still handles interactive boosts.
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0
    write /dev/cpuset/system-background/cpus 0-3
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.kebab

# CS-VOICE helper: started and stopped by the RIL around calls (the audio HAL
# no longer starts it; vendor.audio.mainline.voice_call_service is empty). Kept
# as a disabled init service so it can still be launched manually for debugging.
service vendor.kebab_voicecall /vendor/bin/kona-voicecall
    class main
    user audioserver
    group audio
    disabled

# Hardware APSS watchdog daemon: 10s kick, 20s margin (30s bite <= 31s qcom-wdt
# max; 25s bark -> pretimeout panic governor dumps stacks to ramoops before bite).
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0

# Override camera provider@2.4-service_64 so it starts only after camera.ko is
# loaded and preloads libcamhidl_shim.so (in-process IQtiMapper@3.0 + IPostProcService).
service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service_64
    override
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    class hal
    user cameraserver
    group audio camera input drmrpc graphics
    ioprio rt 4
    capabilities SYS_NICE
    setenv LD_PRELOAD /vendor/lib64/libcamhidl_shim.so
    task_profiles CameraServiceCapacity MaxPerformance
    disabled
