import /vendor/etc/init/hw/init.mainline.qcom.rc

on early-init
    # The RPMB listener tells UFS from eMMC by where this points;
    # qcom-common's bootdevice/by-name then resolves to the controller's own by-name
    symlink /dev/block/platform/soc@0/1d84000.ufshc /dev/block/bootdevice
    # Bring-up: keep logs on /metadata, which survives any reset and is readable from recovery
    mkdir /metadata/bringup 0777 root root

on init
    # qseecomd bridge for stock KeyMint & Gatekeeper
    symlink /dev/qseecom_bridge /dev/qseecom
    # UFS RPMB well-known LU and query node for RPMB listener
    chown system system /dev/0:0:0:49476
    chmod 0660 /dev/0:0:0:49476
    chown system system /dev/ufs-bsg0
    chmod 0660 /dev/ufs-bsg0
    symlink /dev/dma_heap/system /dev/dma_heap/qcom,qseecom
    symlink /dev/dma_heap/system /dev/dma_heap/qseecom
    symlink /dev/dma_heap/system /dev/dma_heap/qseecom_ta

on fs
    mount_all --early

on late-fs
    mount_all --late

on post-fs-data
    # The X55 probes TFTP at ~11 s, before qcom-common's "boot" action runs.
    # Create /data/vendor/tmp/tqftpserv here (after installkey /data has set up
    # FBE in post-fs-data) so tqftpserv can serve /readwrite/ on first boot.
    mkdir /data/vendor/tmp 0755 root root
    mkdir /data/vendor/tmp/tqftpserv 0755 root root
    restorecon_recursive /data/vendor/tmp

on post-fs
    mkdir /mnt/vendor/persist/klog 0775 root system
    # SLPI sensor registry, served by hexagonrpcd-sdsp via hexagonrpcd-root/sensors/registry
    mkdir /mnt/vendor/persist/sensors 0775 system system
    mkdir /mnt/vendor/persist/sensors/registry 0775 system system
    mkdir /mnt/vendor/persist/sensors/registry/registry 0775 system system
    # DSP/Venus firmware is the stock split .mdt/.bNN set on the modem partition
    # (mounted at /vendor/firmware_mnt by mount_all). The DT asks for "adsp.mdt",
    # "cdsp.mdt", "slpi.mdt" and "venus.mdt", so point the kernel loader there
    # before (re)starting the remoteprocs.
    write /sys/module/firmware_class/parameters/path /vendor/firmware_mnt/image
    # The X55 fetches its MCFG/RF config files over TFTP (QRTR service 4096)
    # while it boots, a few seconds after sbl1.mbn becomes readable here.
    # qcom-common only starts tqftpserv at "boot", well after the modem asked
    # (it then came up with no RF: zero bands, stuck offline), so serve them
    # from now on. Debug build of the service: every request goes to kmsg.
    start vendor.tqftpserv_early
    # Venus loads firmware at probe time (before /vendor was mounted); retry now
    write /sys/bus/platform/drivers/qcom-venus/bind aa00000.video-codec
    # pd-mapper must publish the DSP protection-domain maps before the
    # remoteprocs (SLPI sensors, ADSP) start below.
    start vendor.pd-mapper
    # EFS write-back: disabled during bringup to protect mdm1m9kefs* flash partitions
    # from persistent corruption until modem boot stability is fully proven.
    write /sys/module/sahara_mdm/parameters/efs_writeback 0
    # Voice audio calibration level 0 (topology bypass to prevent ADSP -5 failures)
    write /sys/module/q6voice/parameters/cal_level 0
    start vendor.kebab_pdready
    # The external SDX55 is flashless: mhi-pci-generic stays bound and powers
    # it up by itself once sdx55m/sbl1.mbn is readable through the path above
    # (do NOT unbind/rebind it here: that aborts the SBL transfer mid-flight).
    start vendor.bringup_kmsg
    start vendor.bringup_logcat
    start vendor.bringup_diag

# SM8250 has no internal modem (kebab uses an external SDX55), so rmtfs has no
# remote to serve and restart-loops forever; stop it instead of respawning.
on property:init.svc.vendor.rmtfs=restarting
    stop vendor.rmtfs

# Early TFTP server for the external modem (see post-fs). Only one server may
# own QRTR service 4096, so keep qcom-common's late instance from starting.
# "-i 3": stock tftp_server publishes one instance per remote and the X55's
# MPSS only looks up instance 3 (/vendor/rfs/mdm/mpss); instance 1 alone is
# never found, so the modem never fetched its MCFG / RF card files.
service vendor.tqftpserv_early /vendor/bin/tqftpserv -d -i 3
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

service vendor.kebab_pdready /vendor/bin/kebab-pdready.sh
    user root
    group root
    oneshot
    disabled

# DSPs start only after pd-mapper has published the protection-domain maps.
# hexagonrpcd waits in-process for /dev/fastrpc-* so it attaches within 50ms of DSP boot.
on property:sys.kebab.pdready=1
    trigger start_all_remoteproc

on property:init.svc.vendor.tqftpserv=running
    stop vendor.tqftpserv

service vendor.bringup_kmsg /vendor/bin/bringup-log.sh kmsg
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

service vendor.bringup_diag /vendor/bin/bringup-log.sh diag
    user root
    group root radio
    seclabel u:r:su:s0
    oneshot
    disabled

service vendor.bringup_logcat /vendor/bin/bringup-log.sh logcat
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

# zram swap: 50% of RAM, lz4 (zram is built into the kernel)
on property:sys.boot_completed=1
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.kebab

# CS-VOICE helper: started and stopped by the RIL around calls (the audio HAL
# no longer starts it; vendor.audio.mainline.voice_call_service is empty). Kept
# as a disabled init service so it can still be launched manually for debugging.
service vendor.kebab_voicecall /vendor/bin/kona-voicecall
    class main
    user audioserver
    group audio
    disabled
