firmware_directories /lib/firmware/ /system/etc/firmware/ /vendor/firmware/ /odm/firmware/

# Modem AT ports
/dev/wwan0at*             0660   radio      radio
/dev/wwan0qmi*            0660   radio      radio

# Graphics & Memory
/dev/dri/*                0666   system     graphics
/dev/dma_heap/*           0666   system     graphics
/dev/ion                  0664   system     system
/dev/kgsl-3d0             0666   system     graphics

# V4L2 video nodes: Venus codecs (/dev/video0..1, media), camera HAL (camera),
# and UVC USB webcam gadget (/dev/video2+, system/DeviceAsWebcam; SELinux-gated by video_device)
/dev/video*               0666   media      camera
/dev/media*               0660   cameraserver camera
/dev/v4l-subdev*          0660   cameraserver camera
/dev/synx_device          0660   system     camera

# Storage
/dev/block/by-name/*      0660   root       system

# QTEE & QSEECom bridge for Keymaster / Gatekeeper / RPMB / Goodix TA
/dev/tee0                 0660   system     system
/dev/qseecom_bridge       0660   system     system
/dev/0:0:0:49476          0660   system     system
/dev/ufs-bsg0             0660   system     system
/dev/sg*                  0660   system     system

# Goodix optical UDFPS sensor
/dev/goodix_fp            0660   system     system

# AW8697 AAC RichTap X-axis LRA haptics
/dev/awinic_haptic        0660   system     system
