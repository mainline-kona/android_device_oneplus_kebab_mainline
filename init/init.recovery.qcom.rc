# OnePlus 8T (kebab) Mainline Linux 7.2.0 - DSP Remoteproc & USB Gadget Service
service fw_mount_service /system/bin/sh /system/bin/firmware_mount_bind.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service usb_bind_service /system/bin/sh /system/bin/usb_gadget_bind.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

on fs
    wait /dev/block/platform/soc@0/1d84000.ufshc 2
    symlink /dev/block/platform/soc@0/1d84000.ufshc /dev/block/bootdevice
    symlink /dev/block/platform/soc@0/1d84000.ufshc/by-name /dev/block/by-name
    exec_background u:r:recovery:s0 -- /system/bin/sh /system/bin/firmware_mount_bind.sh
    start fw_mount_service

on post-fs
    start fw_mount_service
    start usb_bind_service

on boot
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    setprop sys.usb.state adb
    setprop ro.debuggable 1
    setprop ro.adb.secure 0
    start adbd
    exec_background u:r:recovery:s0 -- /system/bin/sh /system/bin/firmware_mount_bind.sh
    start fw_mount_service
    start usb_bind_service

on property:sys.usb.config=none
    setprop sys.usb.config adb

on property:sys.usb.state=none
    setprop sys.usb.state adb
