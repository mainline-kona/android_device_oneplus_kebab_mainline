# The NXP HAL configuration opens /dev/pn553
on early-boot
    chown nfc nfc /dev/nq-nci
    chmod 0660 /dev/nq-nci
    symlink /dev/nq-nci /dev/pn553

on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc
    mkdir /data/vendor/nfc/param 0770 nfc nfc
