vndbinder_use(hal_camera_default)
allow hal_camera_default self:qipcrtr_socket create_socket_perms_no_ioctl;
allow hal_camera_default self:capability sys_nice;

# CamX walks every property on startup
dontaudit hal_camera_default property_type:file { getattr map open read };

# Camera V4L2 media controller, subdevs, video nodes, and synx fence device
allow hal_camera_default video_device:chr_file rw_file_perms;
allow hal_camera_default camera_device:chr_file rw_file_perms;
allow hal_camera_default vendor_synx_device:chr_file rw_file_perms;
allow hal_camera_default dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_camera_default gpu_device:chr_file rw_file_perms;

# Persistent camera data (/data/vendor/camera, /mnt/vendor/persist/camera) and sysfs/proc queries
allow hal_camera_default vendor_camera_data_file:dir create_dir_perms;
allow hal_camera_default vendor_camera_data_file:file create_file_perms;
allow hal_camera_default mnt_vendor_file:dir search;
allow hal_camera_default vendor_persist_camera_file:dir create_dir_perms;
allow hal_camera_default vendor_persist_camera_file:file create_file_perms;
allow hal_camera_default proc_meminfo:file r_file_perms;
allow hal_camera_default sysfs:dir r_dir_perms;
r_dir_file(hal_camera_default, vendor_sysfs_soc_info)

# Sync fence fd passed from drm_hwcomposer / SurfaceFlinger
allow hal_camera_default hal_graphics_composer_default:fd use;

# CamX OPLUS camera properties & optional IDisplayConfig probe
set_prop(hal_camera_default, vendor_camera_prop)
dontaudit hal_camera_default default_android_hwservice:hwservice_manager find;
