# Backlight
genfscon sysfs /devices/platform/soc@0/ae00000.display-subsystem/ae94000.dsi/ae94000.dsi.0/backlight	u:object_r:vendor_sysfs_backlight:s0

# Bluetooth address seed
genfscon sysfs /devices/soc0/serial_number	u:object_r:vendor_sysfs_soc_info:s0

# Battery, Fuel Gauge, MP2650 Charger & Type-C power supply
genfscon sysfs /devices/platform/soc@0/8c0000.geniqup/888000.i2c/i2c-16/16-0055/power_supply			u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc@0/9c0000.geniqup/994000.i2c/i2c-5/5-005c/power_supply			u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc@0/c440000.spmi/spmi-0/0-02/c440000.spmi:pmic@2:typec@1500/power_supply	u:object_r:sysfs_batteryinfo:s0

# UFS 3.1 storage health & string descriptors (Health HAL)
genfscon sysfs /devices/platform/soc@0/1d84000.ufshc/health_descriptor						u:object_r:vendor_sysfs_ufs:s0
genfscon sysfs /devices/platform/soc@0/1d84000.ufshc/string_descriptors						u:object_r:vendor_sysfs_ufs:s0

# Remoteproc sysfs (SLPI, CDSP, ADSP) for pd-mapper / tqftpserv / rmtfs
genfscon sysfs /class/remoteproc							u:object_r:vendor_sysfs_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/17300000.remoteproc/remoteproc			u:object_r:vendor_sysfs_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/5c00000.remoteproc/remoteproc			u:object_r:vendor_sysfs_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/9890000.remoteproc/remoteproc			u:object_r:vendor_sysfs_remoteproc:s0

# SDX55 raw-IP netdev (mhi_net on IP_HW0): netd sets its MTU via sysfs
genfscon sysfs /devices/platform/soc@0/1c10000.pcie/pci0002:00/0002:00:00.0/0002:01:00.0/mhi0/mhi0_IP_HW0/net	u:object_r:sysfs_net:s0

# OPlus panel HBM & UDFPS finger-press sysfs
genfscon sysfs /kernel/oplus_display	u:object_r:vendor_sysfs_oplus_display:s0

# Goodix UDFPS touchscreen hint procfs node
genfscon proc /touchpanel	u:object_r:vendor_proc_touchpanel:s0

# Linux thermal framework sysfs (/sys/devices/virtual/thermal)
genfscon sysfs /devices/virtual/thermal	u:object_r:sysfs_thermal:s0

# GPU & UFS devfreq sysfs (Power HAL / libperfmgr)
genfscon sysfs /devices/platform/soc@0/3d00000.gpu/devfreq/3d00000.gpu	u:object_r:vendor_sysfs_devfreq:s0
genfscon sysfs /devices/platform/soc@0/1d84000.ufshc/devfreq/1d84000.ufshc	u:object_r:vendor_sysfs_devfreq:s0
