# AT (wwan0at0) and QMI (wwan0qmi0) ports of the external SDX55
allow rild radio_device:chr_file rw_file_perms;
allow rild self:capability { net_admin net_raw };
allow rild self:capability2 block_suspend;
allow rild self:netlink_route_socket create_socket_perms_no_ioctl;
allow rild self:qipcrtr_socket create_socket_perms_no_ioctl;
allow rild self:udp_socket create_socket_perms;
allow rild sysfs_net:dir r_dir_perms;
allow rild sysfs_net:file r_file_perms;
allow rild vendor_file:file { execute_no_trans rx_file_perms };

allowxperm rild self:udp_socket ioctl { SIOCGIFFLAGS SIOCSIFFLAGS SIOCSIFMTU SIOCGIFINDEX SIOCSIFADDR SIOCSIFNETMASK SIOCGIFADDR };
