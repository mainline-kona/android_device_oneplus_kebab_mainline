# Pure-nl80211 IWifi AIDL HAL (libwifi-hal-desktop) over ath11k_pci
allow hal_wifi_default self:netlink_generic_socket create_socket_perms_no_ioctl;
allow hal_wifi_default self:netlink_route_socket create_socket_perms_no_ioctl;
allow hal_wifi_default self:udp_socket create_socket_perms;
allow hal_wifi_default self:capability { net_admin net_raw };
