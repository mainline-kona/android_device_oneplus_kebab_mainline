# Bring-up & SurfaceFlinger
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
# simpledrm takes card0 and unregisters after msm-kms probes; with
# msm.separate_gpu_kms=1, GPU is card1 and msm-kms display is card2.
# drm_hwcomposer stops scanning on missing card0, so point it at card2.
vendor.hwc.drm.device=/dev/dri/card2
# Full Vulkan stack on Mesa 26.2.3 Turnip (Adreno 650, Vulkan 1.3):
# /vendor/etc/drirc (00-turnip-defaults.conf) enables tu_emulate_second_queue
# for "android framework", satisfying Android 17 HWUI's kRequestedQueueCount=2.
debug.hwui.renderer=skiavk
debug.renderengine.backend=skiavkthreaded
# Enable ADPF CPU hint sessions for SurfaceFlinger and HWUI RenderThreads
debug.sf.enable_adpf_cpu_hint=true
debug.hwui.use_hint_manager=true

# Light
vendor.light.backlight.disable=false

# Sensors: libssc over SLPI (accel/gyro/magn/light[wise_light]/proximity/compass)
vendor.sensors.backends=libssc,iio
vendor.sensors.ssc.sensors=accel,gyro,magn,light,proximity,compass
vendor.sensors.wait_for_sensors=0
vendor.sensors.ssc.discovery_wait_ms=5000

# Bluetooth
bluetooth.device.default_name=OnePlus 8T
bluetooth.device.class_of_device=90,2,12
bluetooth.hardware.power.idle_cur_ma=6
bluetooth.hardware.power.rx_cur_ma=28
bluetooth.hardware.power.tx_cur_ma=36
bluetooth.hardware.power.operating_voltage_mv=3700
bluetooth.profile.bas.client.enabled=true
bluetooth.hfp.software_datapath.enabled=true

# USB
vendor.usb.product_string=OnePlus 8T

# Radio: LTE/NR preferred (NR_LTE_GSM_WCDMA) and DSDS (2 physical slots)
persist.radio.multisim.config=dsds
ro.telephony.sim_slots.count=2
ro.telephony.default_network=33,33

# Radio: stock ground-truth parameters
persist.radio.is_vonr_enabled_0=true
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.rat_on=combine
persist.vendor.radio.sib16_support=1

# Fingerprint (Goodix optical UDFPS: center x=540, y=1897, radius=95)
persist.vendor.fingerprint.sensor_location=540|1897|95
persist.vendor.fingerprint.type=udfps

# AAC RichTap X-axis LRA haptics (AW8697)
vendor.aac_richtap.config.path=/vendor/etc/aac_richtap.config
vendor.aac_richtap.device.path=/dev/awinic_haptic

# Gatekeeper (use TEE keymaster64, SM8250 has no SPU)
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# APEX
apexd.config.dm_create.timeout=10000

# Audio HAL voice service: intentionally empty. The RIL owns the CS-VOICE
# helper because the modem inspects the AP voice graph before the call is set
# up; a HAL-started second instance fights the RIL one for the PCM (EBUSY).
vendor.audio.mainline.voice_call_service=
