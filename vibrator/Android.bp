cc_binary {
    name: "android.hardware.vibrator-service.kebab",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.kebab.rc"],
    vintf_fragments: ["android.hardware.vibrator.kebab.xml"],
    vendor: true,
    shared_libs: [
        "android.hardware.vibrator-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    srcs: [
        "Vibrator.cpp",
        "VibratorManager.cpp",
        "VibrationSession.cpp",
        "main.cpp",
    ],
}
