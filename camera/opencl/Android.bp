cc_library_shared {
    name: "libOpenCL_cpu",
    stem: "libOpenCL",
    vendor: true,
    srcs: ["opencl_cpu.cpp"],
    header_libs: ["OpenCL-Headers"],
    shared_libs: ["liblog"],
    cflags: [
        "-DCL_TARGET_OPENCL_VERSION=200",
        "-DCL_USE_DEPRECATED_OPENCL_1_2_APIS",
        "-Wall",
        "-Werror",
    ],
}
