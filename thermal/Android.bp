cc_binary {
    name: "android.hardware.thermal-service.kona",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.thermal-service.kona.rc"],
    vintf_fragments: ["android.hardware.thermal-service.kona.xml"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "android.hardware.thermal-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    srcs: [
        "Thermal.cpp",
        "main.cpp",
    ],
}
